# Local Companion Configuration

# Application mode: "demo" or "local_ai"
COMPANION_MODE=demo

# Wake word enforcement: true or false
WAKE_WORD_ENABLED=true

# Wake phrase
WAKE_PHRASE="Hey Companion"

# llama.cpp server URL (used in local_ai mode)
LLAMA_CPP_URL=http://localhost:8080
LLAMA_CPP_MODEL=default
LLAMA_CPP_TIMEOUT=30

# whisper.cpp server URL (optional)
WHISPER_CPP_URL=http://localhost:8081
WHISPER_CPP_TIMEOUT=30

# Piper TTS binary path (optional)
PIPER_BINARY_PATH=
PIPER_MODEL_PATH=

# Weather API (wttr.in is free and requires no key)
WEATHER_PROVIDER_URL=https://wttr.in
WEATHER_TIMEOUT=10

# Database path
DATABASE_PATH=data/companion.db

# Server configuration
HOST=0.0.0.0
PORT=8000
