# Local Companion Configuration

# Application mode: "demo" or "local_ai"
COMPANION_MODE=local_ai

# Wake word enforcement: true or false
WAKE_WORD_ENABLED=false

# Wake phrase
WAKE_PHRASE="Hey Companion"

# llama.cpp server URL (used in local_ai mode)
LLAMA_CPP_URL=http://127.0.0.1:8082
LLAMA_CPP_MODEL=qwen3-4b
LLAMA_CPP_TIMEOUT=180

# whisper.cpp server URL (optional)
WHISPER_CPP_URL=http://127.0.0.1:8081
WHISPER_CPP_TIMEOUT=120

# Piper TTS binary path (optional)
PIPER_BINARY_PATH=C:/Users/Admin/Downloads/localCompanion/data/tools/piper/piper/piper.exe
PIPER_MODEL_PATH=C:/Users/Admin/Downloads/localCompanion/data/models/piper/en_US-lessac-medium.onnx

# Weather API (wttr.in is free and requires no key)
WEATHER_PROVIDER_URL=https://wttr.in
WEATHER_TIMEOUT=10

# News API (Wikinews, no key needed)
NEWS_PROVIDER_URL=https://en.wikinews.org
NEWS_TIMEOUT=10

# Database path
DATABASE_PATH=data/companion.db

# Server configuration
HOST=0.0.0.0
PORT=8000
